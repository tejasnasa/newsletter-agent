{#-
  Email HTML for the newsletter. Table-based and inline-styled so it survives
  real mail clients; no external images, fonts, or scripts.
-#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:24px 12px;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1f2430;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
    <tr>
      <td align="center">
        <table role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width:640px;width:100%;background:#ffffff;border-radius:12px;border:1px solid #e3e6ea;border-collapse:separate;">
          <tr>
            <td style="padding:28px 32px 8px 32px;">
              <p style="margin:0 0 6px 0;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:#6b7280;">AI Agent Newsletter</p>
              <h1 style="margin:0;font-size:24px;line-height:1.25;color:#111827;">{{ subject }}</h1>
            </td>
          </tr>

          {% if intro %}
          <tr>
            <td style="padding:8px 32px 0 32px;">
              <p style="margin:0;font-size:15px;line-height:1.6;color:#374151;">{{ intro }}</p>
            </td>
          </tr>
          {% endif %}

          <tr>
            <td style="padding:16px 32px 0 32px;">
              <hr style="border:none;border-top:1px solid #e5e7eb;margin:8px 0 0 0;">
            </td>
          </tr>

          {% for item in items %}
          <tr>
            <td style="padding:20px 32px 0 32px;">
              <p style="margin:0 0 4px 0;font-size:12px;color:#6b7280;">{{ loop.index }} of {{ items | length }} &middot; {{ item.source }}{% if item.published %} &middot; {{ item.published }}{% endif %}</p>
              <h2 style="margin:0 0 8px 0;font-size:18px;line-height:1.35;">
                <a href="{{ item.url }}" style="color:#1d4ed8;text-decoration:none;">{{ item.title }}</a>
              </h2>
              <p style="margin:0 0 8px 0;font-size:15px;line-height:1.6;color:#374151;">{{ item.summary }}</p>
              {% if item.why_it_matters %}
              <p style="margin:0 0 4px 0;font-size:14px;line-height:1.55;color:#4b5563;">
                <strong style="color:#111827;">Why it matters:</strong> {{ item.why_it_matters }}
              </p>
              {% endif %}
              <p style="margin:6px 0 0 0;font-size:13px;">
                <a href="{{ item.url }}" style="color:#1d4ed8;text-decoration:underline;">Read the article</a>
              </p>
            </td>
          </tr>
          {% endfor %}

          {% if outro %}
          <tr>
            <td style="padding:24px 32px 0 32px;">
              <p style="margin:0;font-size:14px;line-height:1.6;color:#4b5563;">{{ outro }}</p>
            </td>
          </tr>
          {% endif %}

          <tr>
            <td style="padding:24px 32px 28px 32px;">
              <p style="margin:0;font-size:12px;color:#9ca3af;">Sent by the Newsletter Agent. Every link above points to a real article fetched at run time.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
