# Newsletter Agent configuration.
# Copy this file to .env and fill in the key. NEVER commit .env.

# --- LLM (required) ---------------------------------------------------------
# Any OpenAI-compatible provider. Point LLM_BASE_URL at it, then set the key and
# a model that provider serves. LLM_API_KEY has no default: the run fails fast
# with a clear message if it is missing.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# --- Run behaviour ----------------------------------------------------------
# autonomous | hitl  (overridable per run with --mode or the UI radio button)
DEFAULT_MODE=autonomous
# Maximum revisions from both loops combined (self-critique and human).
MAX_REVISIONS=2

# --- Newsletter shape -------------------------------------------------------
# The acceptance criteria require 5-7 items; the count is enforced in code.
MIN_ITEMS=5
MAX_ITEMS=7
# How far back the research window goes, in days.
TIMEFRAME_DAYS=14

# --- Research limits --------------------------------------------------------
HN_HITS_PER_QUERY=20
MAX_CANDIDATES=60

# --- Output -----------------------------------------------------------------
RECIPIENTS=subscribers@example.com
OUTPUT_DIR=output

# --- Sources (keyless) ------------------------------------------------------
# Every feed below was verified to respond. Comma-separated; leave blank to use
# the built-in default list. Feeds rot: a dead one is skipped, never fatal.
# RSS_FEEDS=https://techcrunch.com/category/artificial-intelligence/feed/,https://openai.com/news/rss.xml
# Queries used when the planner's own queries fail, or the pool is too small.
# FALLBACK_HN_QUERIES=AI agent,agentic AI,LLM agent framework
